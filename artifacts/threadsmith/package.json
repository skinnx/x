{
  "name": "threadsmith",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The self-hosted publishing layer for AI agents: posts and threads on X, Bluesky, Mastodon, Threads, LinkedIn, Telegram and Discord. Single process, SQLite.",
  "bin": {
    "threadsmith": "./cli/threadsmith.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch --clear-screen=false --disable-warning=ExperimentalWarning server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit",
    "cli": "node cli/threadsmith.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@date-fns/tz": "^1.5.0",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-openapi": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@scalar/hono-api-reference": "^0.12.0",
    "hono": "^4.13.0",
    "tsx": "^4.23.0",
    "web-push": "^3.6.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.0.0",
    "lucide-react": "^1.60.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
